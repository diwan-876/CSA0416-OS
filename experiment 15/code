
#include <stdio.h>
#include <string.h>

int main() {
    char users[10][20];
    char files[10][10][20];
    int count[10] = {0};
    int nu = 0, choice, i, u, found;
    char user[20], file[20];

    while (1) {
        printf("\n1. Create User\n");
        printf("2. Create File\n");
        printf("3. Search File\n");
        printf("4. Display Directory\n");
        printf("5. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {
        case 1:
            if (nu == 10) {
                printf("Maximum users reached\n");
                break;
            }

            printf("Enter user name: ");
            scanf("%19s", user);

            found = 0;
            for (i = 0; i < nu; i++)
                if (strcmp(users[i], user) == 0)
                    found = 1;

            if (found)
                printf("User already exists\n");
            else {
                strcpy(users[nu++], user);
                printf("User created successfully\n");
            }
            break;

        case 2:
            printf("Enter user name: ");
            scanf("%19s", user);
            u = -1;

            for (i = 0; i < nu; i++)
                if (strcmp(users[i], user) == 0)
                    u = i;

            if (u == -1) {
                printf("User not found\n");
                break;
            }

            if (count[u] == 10) {
                printf("Directory is full\n");
                break;
            }

            printf("Enter file name: ");
            scanf("%19s", file);

            found = 0;
            for (i = 0; i < count[u]; i++)
                if (strcmp(files[u][i], file) == 0)
                    found = 1;

            if (found)
                printf("File already exists\n");
            else {
                strcpy(files[u][count[u]++], file);
                printf("File created successfully\n");
            }
            break;

        case 3:
            printf("Enter user name: ");
            scanf("%19s", user);
            printf("Enter file name: ");
            scanf("%19s", file);

            u = -1;
            for (i = 0; i < nu; i++)
                if (strcmp(users[i], user) == 0)
                    u = i;

            found = 0;
            if (u != -1)
                for (i = 0; i < count[u]; i++)
                    if (strcmp(files[u][i], file) == 0)
                        found = 1;

            if (found)
                printf("File found\n");
            else
                printf("File not found\n");
            break;

        case 4:
            for (i = 0; i < nu; i++) {
                int j;
                printf("\nUser: %s\n", users[i]);
                for (j = 0; j < count[i]; j++)
                    printf("  %s\n", files[i][j]);
            }
            break;

        case 5:
            return 0;

        default:
            printf("Invalid choice\n");
        }
    }
}
