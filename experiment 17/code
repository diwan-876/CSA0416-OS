
#include <stdio.h>

int main() {
    int n, m, i, j, k;
    int alloc[10][10], max[10][10], need[10][10];
    int avail[10], finish[10] = {0}, safe[10];
    int work[10], count = 0, found;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter number of resources: ");
    scanf("%d", &m);

    printf("Enter allocation matrix:\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < m; j++)
            scanf("%d", &alloc[i][j]);

    printf("Enter maximum requirement matrix:\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < m; j++)
            scanf("%d", &max[i][j]);

    printf("Enter available resources:\n");
    for (j = 0; j < m; j++)
        scanf("%d", &avail[j]);

    for (i = 0; i < n; i++)
        for (j = 0; j < m; j++) {
            need[i][j] = max[i][j] - alloc[i][j];
            if (need[i][j] < 0) {
                printf("Invalid matrices\n");
                return 1;
            }
        }

    for (j = 0; j < m; j++)
        work[j] = avail[j];

    while (count < n) {
        found = 0;

        for (i = 0; i < n; i++) {
            if (finish[i] == 0) {
                for (j = 0; j < m; j++)
                    if (need[i][j] > work[j])
                        break;

                if (j == m) {
                    for (k = 0; k < m; k++)
                        work[k] += alloc[i][k];

                    safe[count++] = i;
                    finish[i] = 1;
                    found = 1;
                }
            }
        }

        if (!found)
            break;
    }

    if (count == n) {
        printf("\nSystem is in a SAFE state\n");
        printf("Safe sequence: ");
        for (i = 0; i < n; i++)
            printf("P%d%s", safe[i],
                   i == n - 1 ? "\n" : " -> ");
    } else {
        printf("\nSystem is in an UNSAFE state\n");
        printf("No safe sequence exists.\n");
    }

    return 0;
}
