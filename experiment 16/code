
#include <stdio.h>

struct Employee {
    int id;
    char name[30];
    float salary;
};

int main() {
    FILE *fp;
    struct Employee e;
    int n, i, record;

    fp = fopen("employee.dat", "wb+");
    if (fp == NULL) {
        printf("Unable to open file\n");
        return 1;
    }

    printf("Enter number of employees: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("\nEnter employee ID, name and salary: ");
        scanf("%d %29s %f", &e.id, e.name, &e.salary);

        fwrite(&e, sizeof(e), 1, fp);
    }

    printf("\nEnter record number to access (1 to %d): ", n);
    scanf("%d", &record);

    if (record < 1 || record > n) {
        printf("Invalid record number\n");
    } else {
        fseek(fp, (long)(record - 1) * sizeof(e), SEEK_SET);

        if (fread(&e, sizeof(e), 1, fp) == 1) {
            printf("\nEmployee Details\n");
            printf("ID: %d\n", e.id);
            printf("Name: %s\n", e.name);
            printf("Salary: %.2f\n", e.salary);
        } else {
            printf("Error reading record\n");
        }
    }

    fclose(fp);
    return 0;
}
