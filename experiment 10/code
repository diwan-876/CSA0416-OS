#include <stdio.h>
#include <stdlib.h>
#include <sys/ipc.h>
#include <sys/msg.h>

struct message {
    long type;
    char text[100];
};

int main() {
    int id = msgget(IPC_PRIVATE, 0666 | IPC_CREAT);
    struct message msg;

    if (id == -1) {
        perror("msgget");
        return 1;
    }

    msg.type = 1;
    snprintf(msg.text, sizeof(msg.text),
             "Hello from sender");

    if (msgsnd(id, &msg, sizeof(msg.text), 0) == -1) {
        perror("msgsnd");
        msgctl(id, IPC_RMID, NULL);
        return 1;
    }

    printf("Message sent: %s\n", msg.text);

    if (msgrcv(id, &msg, sizeof(msg.text), 1, 0) == -1) {
        perror("msgrcv");
        msgctl(id, IPC_RMID, NULL);
        return 1;
    }

    printf("Message received: %s\n", msg.text);
    msgctl(id, IPC_RMID, NULL);

    return 0;
}
